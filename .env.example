# ---------------------------------------------------------------------------
# Career Connect — environment template
# Copy to `.env` and fill in real values. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Client-side (safe to expose, bundled into the browser build) -----------
# Base URL of the deployed Java Tomcat backend (e.g., https://career-connect-backend.onrender.com)
# Leave empty for local development (defaults to local Vite proxy -> http://localhost:8085)
VITE_BACKEND_URL=
VITE_API_URL=

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server-side (server functions / SSR only, never sent to the browser) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# Privileged key. Required only for admin/back-office server functions.
# Managed automatically on Lovable Cloud; set manually for self-hosting.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI gateway -------------------------------------------------------------
# Injected automatically on Lovable. Required when self-hosting AI features.
LOVABLE_API_KEY=

# --- Analytics / warehouse --------------------------------------------------
# Row-volume multiplier used by scripts/build-data-platform.ts (default: 1)
ANALYTICS_SCALE=1

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3000