<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>CareerConnect-WT-Lab</display-name>
    <description>Career Connect Web Technology Lab - Servlets and JSP Applications</description>

    <!-- Remote IP Filter: detects HTTPS and client IP when behind reverse proxies (Render, Railway, Cloudflare, etc.) -->
    <filter>
        <filter-name>RemoteIpFilter</filter-name>
        <filter-class>org.apache.catalina.filters.RemoteIpFilter</filter-class>
        <init-param>
            <param-name>protocolHeader</param-name>
            <param-value>X-Forwarded-Proto</param-value>
        </init-param>
        <init-param>
            <param-name>remoteIpHeader</param-name>
            <param-value>X-Forwarded-For</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>RemoteIpFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Career Connect CORS Security & Dynamic Cross-Site Cookie Filter -->
    <filter>
        <filter-name>CorsSecurityFilter</filter-name>
        <filter-class>CorsSecurityFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsSecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Exercise 5(A) & 6(B): CareerServlet -->
    <servlet>
        <servlet-name>CareerServlet</servlet-name>
        <servlet-class>CareerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CareerServlet</servlet-name>
        <url-pattern>/CareerServlet</url-pattern>
    </servlet-mapping>

    <!-- Exercise 5(B): SessionTrackingServlet -->
    <servlet>
        <servlet-name>SessionTrackingServlet</servlet-name>
        <servlet-class>SessionTrackingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SessionTrackingServlet</servlet-name>
        <url-pattern>/SessionTrackingServlet</url-pattern>
    </servlet-mapping>

    <!-- Authentication & Identity Gateway: AuthServlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/AuthServlet</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
            <path>/</path>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index-5a.html</welcome-file>
        <welcome-file>index-5b.html</welcome-file>
        <welcome-file>career.jsp</welcome-file>
        <welcome-file>profile.jsp</welcome-file>
    </welcome-file-list>

</web-app>
